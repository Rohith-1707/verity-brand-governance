# VERITY Configuration Template
# -------------------------------------------------------------
# 1. Database (Leave blank or set to sqlite:///verity.db for instant zero-dependency local testing)
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 2. Local JWT & Session Security
JWT_SECRET=verity-production-secure-jwt-secret-key-2026

# 3. Supabase Auth Integration (Optional; needed only if authenticating with Supabase Auth)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only needed if using Supabase legacy HS256 secret:
SUPABASE_JWT_SECRET=

# 4. CORS Origins (Comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# 5. AI Credibility Screening (Optional: Anthropic Claude API)
# Without these, verification runs purely with deterministic Knowledge Base grounding & guideline checks.
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# 6. Persistent Vector Storage (Optional: persistent ChromaDB path)
CHROMA_PATH=
